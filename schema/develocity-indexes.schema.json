{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GBOS Develocity scalar index registry",
  "type": "object",
  "required": ["schemaVersion", "description", "indexes"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "indexes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/index"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "maxLength": 255
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 255
    },
    "index": {
      "type": "object",
      "required": ["name", "producer", "scope", "metric", "aggregation", "aggregationScope"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^gbos\\.v1\\.index\\.[a-z0-9_]+\\.[a-z][a-z0-9_.]*\\.(last|min|max|sum|count)$",
          "maxLength": 255
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "scope": {
          "$ref": "#/$defs/name"
        },
        "metric": {
          "$ref": "#/$defs/name"
        },
        "aggregation": {
          "enum": ["last", "min", "max", "sum", "count"]
        },
        "aggregationScope": {
          "const": "build"
        }
      },
      "additionalProperties": false
    }
  }
}
